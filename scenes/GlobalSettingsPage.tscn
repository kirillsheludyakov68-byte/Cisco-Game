[ext_resource type="PackedScene" path="res://scenes/GatewayDnsBlock.tscn" id="2_block"]

[node name="GlobalSettingsPage" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
